# Perfil local obligatorio. Copiar a .env y ejecutar scripts/prepare_local.py.
# No contiene contraseñas: se generan en archivos locales ignorados por Git.
APP_ENV=local
HTTP_PORT=8080
S3_BUCKET=agro-local
S3_REGION=us-east-1
PERSISTENCE_SECRETS_DIR=./.local/persistence
# Opcional: UID/GID de APIs; preparador y Compose usan el usuario local.
LOCAL_UID=1000
LOCAL_GID=1000
# El ciclo v1.4.3 fue rechazado en evaluación externa. La inferencia real queda
# bloqueada; el perfil explícito `demo` se abstiene sin cargar un modelo.
REAL_INFERENCE_AUTHORIZED=false
# Producción pendiente: DOMAIN_NAME, CLOUDFLARE_API_TOKEN, CLOUDFLARE_ZONE_ID,
# SSL_CERT_PATH, SSL_KEY_PATH, CDN_BASE_URL, proveedor de correo y observabilidad.
# No son requeridos por este perfil ni deben rellenarse con credenciales reales.

# Si cambia HTTP_PORT, ajustar también los orígenes exactos permitidos.
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Extensión desacoplada de asistente conversacional (perfil Compose: --profile assistant).
# Desactivada por defecto; los cuatro servicios núcleo no dependen de esta configuración.
# GEMINI_API_KEY se aporta fuera de Git únicamente cuando se activa ASSISTANT_PROVIDER=gemini.
ASSISTANT_ENABLED=false
ASSISTANT_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
ASSISTANT_TIMEOUT_SECONDS=10
ASSISTANT_MAX_INPUT_CHARS=2000
ASSISTANT_MAX_OUTPUT_TOKENS=512
ASSISTANT_RATE_LIMIT=20/60s
ASSISTANT_MAX_RETRIES=1
