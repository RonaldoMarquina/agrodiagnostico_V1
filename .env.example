# Perfil local obligatorio. Copiar a .env y ejecutar scripts/prepare_local.py.
# No contiene contraseñas: se generan en archivos locales ignorados por Git.
APP_ENV=local
HTTP_PORT=8080
S3_BUCKET=agro-local
S3_REGION=us-east-1
PERSISTENCE_SECRETS_DIR=./.local/persistence
# Opcional: UID/GID de APIs; preparador y Compose usan el usuario local.
LOCAL_UID=1000
LOCAL_GID=1000
# Producción pendiente: DOMAIN_NAME, CLOUDFLARE_API_TOKEN, CLOUDFLARE_ZONE_ID,
# SSL_CERT_PATH, SSL_KEY_PATH, CDN_BASE_URL, proveedor de correo y observabilidad.
# No son requeridos por este perfil ni deben rellenarse con credenciales reales.

# Si cambia HTTP_PORT, ajustar también los orígenes exactos permitidos.
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
