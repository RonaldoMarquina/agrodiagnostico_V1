      "WEBP": "SINGLE_FRAME_REQUIRED"
    },
    "exif_transpose": true,
    "alpha_composite": "OPAQUE_WHITE",
    "output_color_space": "RGB"
  },
  "resize": {
    "method": "DIRECT_RESIZE",
    "width": 224,
    "height": 224,
    "interpolation": "BILINEAR"
