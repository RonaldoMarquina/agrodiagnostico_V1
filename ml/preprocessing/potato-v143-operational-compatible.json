{
  "schema_version": 1,
  "preprocessing_version": "1.4.3",
  "implementation": "ml/src/agro_ml/data/tensor_preprocessing.py:image_to_tensor",
  "shared_by": ["TRAIN", "VAL", "TEST", "EXTERNAL", "INFERENCE"],
  "decode": {
