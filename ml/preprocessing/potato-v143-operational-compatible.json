    "std": [0.229, 0.224, 0.225]
  },
  "frozen_model_parameters": {
    "source_cycle": "1.4.2",
    "freeze_digest": "07ef4eac80f59b7ca1fc42031092f3353e7e2dd89d6c8c8c17fda4865c85110a",
    "weights_sha256": "e96201dc79bfd5aa99a55430f5a523f47ff91fe82d6d9de1ffc8249c06c6472c",
    "architecture": "MOBILENET_V3_SMALL",
    "temperature": 0.5,
    "threshold": 0.8,
    "technical_classes": [
      "POTATO_EARLY_BLIGHT",
      "POTATO_LATE_BLIGHT",
      "POTATO_HEALTHY",
      "OTHER_CROP"
    ],
    "publishable_classes": [
      "POTATO_EARLY_BLIGHT",
      "POTATO_LATE_BLIGHT"
    ]
  },
  "augmentation": {
    "allowed_only_for": {"split": "TRAIN", "class_code": "POTATO_HEALTHY"},
    "forbidden_splits": ["VAL", "TEST", "EXTERNAL", "INFERENCE"]
