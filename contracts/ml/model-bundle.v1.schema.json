{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-bundle.v1.schema.json",
  "title": "ModelBundleV1",
  "description": "Contrato inmutable de empaquetado de modelo de inferencia agronómica V1. Desde G0 v1.4.1 las salidas técnicas de rechazo se distinguen de los diagnósticos publicables.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "bundle_id": {
      "type": "string",
      "format": "uuid"
    },
    "model_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$",
      "description": "Identificador único y canónico del modelo (e.g. agrodiagnostico-mobilenetv3-cpu)."
    },
    "model_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
      "description": "Versión semántica del modelo."
    },
    "dataset_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
      "description": "Versión semántica del dataset con el que fue entrenado."
    },
    "architecture": {
      "type": "string",
      "enum": [
        "mobilenet_v3_small",
        "mobilenet_v3_large",
        "resnet18",
        "resnet34",
        "efficientnet_b0"
      ],
      "description": "Arquitectura de red neuronal permitida para ejecución en CPU."
    },
    "weights": {
      "type": "object",
      "properties": {
        "filename": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+\\.(pt|pth|safetensors)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Digest SHA-256 en minúsculas del archivo binario de pesos."
        },
        "format": {
          "type": "string",
          "enum": [
            "safetensors",
            "state_dict_weights_only",
            "torchscript"
          ]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 524288000
        }
      },
      "required": [
        "filename",
        "sha256",
        "format",
        "size_bytes"
      ],
      "additionalProperties": false
    },
    "manifest_checksums": {
      "type": "object",
      "properties": {
        "train_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "val_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "test_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "train_manifest_sha256",
        "val_manifest_sha256"
      ],
      "additionalProperties": false
    },
    "manifest_component_checksums": {
      "type": "object",
      "description": "Pares de manifiestos positivos y negativos usados por el piloto; cada digest combinado de manifest_checksums se deriva de estos pares.",
      "properties": {
        "train": {"$ref": "#/$defs/manifestPair"},
        "val": {"$ref": "#/$defs/manifestPair"},
        "test": {"$ref": "#/$defs/manifestPair"}
      },
      "required": ["train", "val", "test"],
      "additionalProperties": false
    },
    "artifact_checksums": {
      "type": "object",
      "description": "SHA-256 de los componentes inmutables, incluida la evaluación TEST ya ejecutada.",
      "properties": {
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "calibration_sha256": {"$ref": "#/$defs/sha256"},
        "thresholds_sha256": {"$ref": "#/$defs/sha256"},
        "protocol_sha256": {"$ref": "#/$defs/sha256"},
        "freeze_sha256": {"$ref": "#/$defs/sha256"},
        "test_report_sha256": {"$ref": "#/$defs/sha256"},
        "val_report_sha256": {"$ref": "#/$defs/sha256"},
        "external_report_sha256": {"$ref": "#/$defs/sha256"},
        "preprocessing_code_sha256": {"$ref": "#/$defs/sha256"},
        "dependency_lock_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "class_map": {
      "type": "object",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "object",
          "properties": {
            "class_code": {
              "type": "string",
              "enum": [
                "POTATO_HEALTHY",
                "POTATO_EARLY_BLIGHT",
                "POTATO_LATE_BLIGHT",
                "OTHER_CROP",
                "MAIZE_HEALTHY",
                "MAIZE_COMMON_RUST",
                "MAIZE_LEAF_BLIGHT",
                "MAIZE_GRAY_LEAF_SPOT"
              ]
            },
            "crop_code": {
              "type": "string",
              "enum": [
                "POTATO",
                "MAIZE",
                "OTHER"
              ]
            }
          },
          "required": [
            "class_code",
            "crop_code"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "Mapeo de índice numérico de salida a códigos contractuales."
    },
    "publishable_classes": {
      "type": "array",
      "description": "Subconjunto de salidas técnicas que Diagnosis puede publicar tras política y catálogo.",
      "items": {
        "type": "string",
        "enum": ["POTATO_EARLY_BLIGHT", "POTATO_LATE_BLIGHT"]
      },
      "uniqueItems": true
    },
    "preprocessing": {
      "type": "object",
      "properties": {
        "input_size": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 64,
            "maximum": 1024
          },
          "minItems": 2,
          "maxItems": 2
        },
        "channels": {
          "type": "integer",
          "const": 3
        },
        "color_space": {
          "type": "string",
          "const": "RGB"
        },
        "mean": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 3,
          "maxItems": 3
        },
        "std": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "input_size",
        "channels",
        "color_space",
        "mean",
        "std"
      ],
      "additionalProperties": false
    },
    "rejection_components": {
      "type": "object",
      "properties": {
        "min_confidence_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "crop_detection_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "identified_crop_required": {
          "type": "string",
          "const": "POTATO"
        },
        "technical_reject_policy": {
          "type": "string",
          "enum": [
            "OTHER_CROP_LOGIT_GTE_CANDIDATE",
            "NON_PUBLISHABLE_ARGMAX_OR_LOW_CONFIDENCE"
          ]
        },
        "min_dimension": {
          "type": "integer",
          "minimum": 64
        },
        "max_dimension": {
          "type": "integer",
          "maximum": 10000
        }
      },
      "required": [
        "min_confidence_threshold",
        "min_dimension",
        "max_dimension"
      ],
      "additionalProperties": false
    },
    "calibration": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "TEMPERATURE_SCALING",
            "PLATT_SCALING",
            "ISOTONIC_REGRESSION",
            "SCALAR_AFFINE"
          ]
        },
        "parameters_per_class": {
          "type": "object",
          "patternProperties": {
            "^[A-Z][A-Z0-9_]+$": {
              "type": "object",
              "properties": {
                "slope": {
                  "type": "number"
                },
                "intercept": {
                  "type": "number"
                }
              },
              "required": [
                "slope",
                "intercept"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "method",
        "parameters_per_class"
      ],
      "additionalProperties": false
    },
    "runtime_environment": {
      "type": "object",
      "properties": {
        "python_version": {
          "type": "string",
          "pattern": "^3\\.1[0-9](\\.[0-9]+)?$"
        },
        "framework": {
          "type": "string",
          "enum": [
            "pytorch",
            "onnxruntime"
          ]
        },
        "framework_version": {
          "type": "string",
          "minLength": 1
        },
        "target_device": {
          "type": "string",
          "const": "cpu"
        }
      },
      "required": [
        "python_version",
        "framework",
        "framework_version",
        "target_device"
      ],
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "properties": {
        "g0_protocol_version": {
          "type": "string"
        },
        "g2_approval_id": {
          "type": "string"
        },
        "approved_by": {
          "type": "string"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "release_status": {
          "type": "string",
          "enum": ["PRE_EXTERNAL_FROZEN", "G2_APPROVED", "G2_REJECTED"]
        }
      },
      "required": [
        "g0_protocol_version"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "bundle_id",
    "model_id",
    "model_version",
    "dataset_version",
    "architecture",
    "weights",
    "manifest_checksums",
    "class_map",
    "preprocessing",
    "rejection_components",
    "calibration",
    "runtime_environment",
    "governance"
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "manifestPair": {
      "type": "object",
      "properties": {
        "positives": {"$ref": "#/$defs/sha256"},
        "negatives": {"$ref": "#/$defs/sha256"}
      },
      "required": ["positives", "negatives"],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "governance": {
            "type": "object",
            "properties": {
              "g0_protocol_version": {
                "const": "1.2.0"
              }
            }
          }
        },
        "required": [
          "governance"
        ]
      },
      "then": {
        "required": ["manifest_component_checksums", "artifact_checksums"],
        "properties": {
          "rejection_components": {
            "required": ["identified_crop_required", "technical_reject_policy"],
            "not": {"required": ["crop_detection_threshold"]}
          },
          "class_map": {
            "type": "object",
            "patternProperties": {
              "^[0-9]+$": {
                "type": "object",
                "properties": {
                  "class_code": {
                    "enum": [
                      "POTATO_EARLY_BLIGHT",
                      "POTATO_LATE_BLIGHT"
                    ]
                  },
                  "crop_code": {
                    "const": "POTATO"
                  }
                },
                "required": [
                  "class_code",
                  "crop_code"
                ]
              }
            },
            "minProperties": 2,
            "maxProperties": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "governance": {
            "properties": {"g0_protocol_version": {"const": "1.4.1"}},
            "required": ["g0_protocol_version"]
          }
        },
        "required": ["governance"]
      },
      "then": {
        "required": ["artifact_checksums", "publishable_classes"],
        "properties": {
          "manifest_checksums": {
            "required": ["train_manifest_sha256", "val_manifest_sha256"],
            "not": {"required": ["test_manifest_sha256"]}
          },
          "artifact_checksums": {
            "required": ["config_sha256", "calibration_sha256", "thresholds_sha256", "protocol_sha256", "freeze_sha256", "val_report_sha256", "preprocessing_code_sha256", "dependency_lock_sha256"],
            "not": {"required": ["test_report_sha256"]}
          },
          "class_map": {
            "properties": {
              "0": {"properties": {"class_code": {"const": "POTATO_EARLY_BLIGHT"}, "crop_code": {"const": "POTATO"}}},
              "1": {"properties": {"class_code": {"const": "POTATO_LATE_BLIGHT"}, "crop_code": {"const": "POTATO"}}},
              "2": {"properties": {"class_code": {"const": "POTATO_HEALTHY"}, "crop_code": {"const": "POTATO"}}},
              "3": {"properties": {"class_code": {"const": "OTHER_CROP"}, "crop_code": {"const": "OTHER"}}}
            },
            "required": ["0", "1", "2", "3"],
            "minProperties": 4,
            "maxProperties": 4
          },
          "publishable_classes": {
            "prefixItems": [
              {"const": "POTATO_EARLY_BLIGHT"},
              {"const": "POTATO_LATE_BLIGHT"}
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "rejection_components": {
            "properties": {"technical_reject_policy": {"const": "NON_PUBLISHABLE_ARGMAX_OR_LOW_CONFIDENCE"}},
            "required": ["identified_crop_required", "technical_reject_policy"]
          },
          "governance": {
            "required": ["g0_protocol_version", "release_status"]
          }
        }
      },
      "else": {
        "properties": {
          "manifest_checksums": {"required": ["train_manifest_sha256", "val_manifest_sha256", "test_manifest_sha256"]},
          "artifact_checksums": {"required": ["config_sha256", "calibration_sha256", "thresholds_sha256", "protocol_sha256", "freeze_sha256", "test_report_sha256", "preprocessing_code_sha256", "dependency_lock_sha256"]},
          "governance": {"required": ["g0_protocol_version", "g2_approval_id", "approved_by", "approved_at"]}
        }
      }
    }
  ]
}
