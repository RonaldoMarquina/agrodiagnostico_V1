{
  "openapi": "3.1.1",
  "info": {
    "title": "AgroDiagnóstico identity",
    "version": "1.0.0",
    "description": "Contrato inicial: salud técnica implementada; operaciones de negocio contract-only. Sin servidores públicos inventados."
  },
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "identity_live",
        "summary": "Salud live interna",
        "description": "Solo red interna. No expuesta por proxy. Liveness no sondea dependencias. Readiness según D2; no acredita modelo cargado en incremento 0.",
        "security": [],
        "responses": {
          "200": {
            "description": "Salud técnica implementada; no acredita funcionalidad de negocio.",
            "headers": {
              "X-Correlation-ID": {
                "required": true,
                "schema": {
                  "$ref": "../schemas/common.schema.json#/$defs/UUID"
                },
                "example": "11111111-1111-4111-8111-111111111111"
              },
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                },
                "example": "private, no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "alive"
                    },
                    "service": {
                      "const": "identity"
                    }
                  },
                  "required": [
                    "status",
                    "service"
                  ],
                  "additionalProperties": false
                },
                "example": {
                  "status": "alive",
                  "service": "identity"
                }
              }
            }
          }
        },
        "x-status": "implemented",
        "x-owner": "identity",
        "x-increment": 0,
        "x-visibility": "internal"
      }
    },
