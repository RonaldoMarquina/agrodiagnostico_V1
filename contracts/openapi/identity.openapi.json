    "/api/v1/auth/login": {
      "post": {
        "operationId": "identity_login",
        "summary": "Crear sesión",
        "description": "Origin obligatorio permitido para evitar login CSRF; credenciales inválidas/bloqueo 401 genérico. Devuelve access y csrf en JSON, refresh exclusivamente cookie.",
