              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ready"
                    },
                    "service": {
                      "const": "notification"
                    }
                  },
                  "required": [
                    "status",
                    "service"
                  ],
                  "additionalProperties": false
                },
                "example": {
                  "status": "ready",
                  "service": "notification"
                }
              }
            }
          },
          "503": {
            "description": "Dependencia indispensable o migración/configuración no disponible; sin detalles sensibles.",
            "headers": {
              "X-Correlation-ID": {
                "required": true,
                "schema": {
                  "$ref": "../schemas/common.schema.json#/$defs/UUID"
                },
                "example": "11111111-1111-4111-8111-111111111111"
              },
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                },
                "example": "private, no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "not_ready"
                    },
                    "service": {
                      "const": "notification"
                    }
                  },
                  "required": [
                    "status",
                    "service"
                  ],
                  "additionalProperties": false
                },
                "example": {
                  "status": "not_ready",
                  "service": "notification"
                }
              }
            }
          }
        },
        "x-status": "implemented",
        "x-owner": "notification",
        "x-increment": 0,
        "x-visibility": "internal"
      }
    },
    "/api/v1/notifications": {
      "get": {
        "operationId": "notification_list",
        "summary": "Avisos propios paginados",
        "description": "Solo avisos del usuario; orden created_at DESC,id DESC; cursor inválido/ajeno400 genérico. CANCELADO no genera aviso. Lectura de aviso tendrá contrato separado en incremento5.",
        "security": [
          {
            "UserBearer": []
          }
        ],
        "parameters": [
          {
            "name": "X-Correlation-ID",
            "in": "header",
            "required": false,
            "schema": {
              "$ref": "../schemas/common.schema.json#/$defs/UUID"
            },
            "example": "11111111-1111-4111-8111-111111111111",
            "description": "UUID del cliente o generado por servidor si falta; valor inválido 400; eco en respuesta."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "example": 20
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "example": "cursor-opaco-de-ejemplo",
            "description": "Opaco, vinculado a propietario/filtros; inválido 400. Orden created_at DESC, id DESC; keyset, no offset."
          }
        ],
        "responses": {
          "200": {
            "description": "Respuesta prevista; aún no implementada.",
            "headers": {
              "X-Correlation-ID": {
                "required": true,
                "schema": {
                  "$ref": "../schemas/common.schema.json#/$defs/UUID"
                },
                "example": "11111111-1111-4111-8111-111111111111"
              },
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                },
                "example": "private, no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/common.schema.json#/$defs/NotificationPage"
                },
                "example": {
                  "items": [
                    {
                      "id": "22222222-2222-4222-8222-222222222222",
                      "diagnosis_id": "11111111-1111-4111-8111-111111111111",
                      "final_status": "NO_CONCLUYENTE",
                      "created_at": "2026-09-28T12:00:00Z",
                      "read_at": null
                    }
                  ],
                  "next_cursor": null
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida.",
            "headers": {
              "X-Correlation-ID": {
                "required": true,
                "schema": {
                  "$ref": "../schemas/common.schema.json#/$defs/UUID"
                },
                "example": "11111111-1111-4111-8111-111111111111"
              },
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                },
                "example": "private, no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/common.schema.json#/$defs/Error"
                },
                "example": {
                  "code": "INVALID_REQUEST",
                  "message": "Solicitud inválida.",
                  "correlation_id": "11111111-1111-4111-8111-111111111111"
                }
              }
            }
          },
          "401": {
            "description": "Autenticación requerida o inválida.",
            "headers": {
              "X-Correlation-ID": {
                "required": true,
                "schema": {
                  "$ref": "../schemas/common.schema.json#/$defs/UUID"
                },
                "example": "11111111-1111-4111-8111-111111111111"
              },
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                },
                "example": "private, no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/common.schema.json#/$defs/Error"
                },
                "example": {
                  "code": "UNAUTHORIZED",
                  "message": "Autenticación requerida o inválida.",
                  "correlation_id": "11111111-1111-4111-8111-111111111111"
                }
              }
            }
          }
        },
        "x-status": "contract-only",
        "x-owner": "notification",
        "x-increment": 5
      }
    },
