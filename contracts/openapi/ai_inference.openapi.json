{
  "openapi": "3.1.1",
  "info": {
    "title": "AgroDiagnóstico ai_inference",
    "version": "1.0.0",
    "description": "Contrato inicial: salud técnica implementada; operaciones de negocio contract-only. Sin servidores públicos inventados."
  },
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "ai_inference_live",
        "summary": "Salud live interna",
        "description": "Solo red interna. No expuesta por proxy. Liveness no sondea dependencias. Readiness según D2; no acredita modelo cargado en incremento 0.",
        "security": [],
        "responses": {
          "200": {
            "description": "Salud técnica implementada; no acredita funcionalidad de negocio.",
            "headers": {
              "X-Correlation-ID": {
                "required": true,
                "schema": {
                  "$ref": "../schemas/common.schema.json#/$defs/UUID"
                },
                "example": "11111111-1111-4111-8111-111111111111"
              },
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                },
                "example": "private, no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "alive"
                    },
                    "service": {
                      "const": "ai_inference"
                    }
                  },
                  "required": [
                    "status",
                    "service"
                  ],
                  "additionalProperties": false
                },
                "example": {
                  "status": "alive",
                  "service": "ai_inference"
                }
              }
            }
          }
        },
        "x-status": "implemented",
        "x-owner": "ai_inference",
        "x-increment": 0,
        "x-visibility": "internal"
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ai_inference_ready",
        "summary": "Salud ready interna",
        "description": "Solo red interna. No expuesta por proxy. Liveness no sondea dependencias. Readiness según D2; no acredita modelo cargado en incremento 0.",
        "security": [],
        "responses": {
          "200": {
            "description": "Salud técnica implementada; no acredita funcionalidad de negocio.",
            "headers": {
              "X-Correlation-ID": {
                "required": true,
                "schema": {
                  "$ref": "../schemas/common.schema.json#/$defs/UUID"
                },
                "example": "11111111-1111-4111-8111-111111111111"
              },
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                },
                "example": "private, no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ready"
                    },
                    "service": {
                      "const": "ai_inference"
                    }
                  },
                  "required": [
                    "status",
                    "service"
                  ],
                  "additionalProperties": false
                },
                "example": {
                  "status": "ready",
                  "service": "ai_inference"
                }
              }
            }
          },
          "503": {
            "description": "Dependencia indispensable o migración/configuración no disponible; sin detalles sensibles.",
            "headers": {
              "X-Correlation-ID": {
                "required": true,
                "schema": {
                  "$ref": "../schemas/common.schema.json#/$defs/UUID"
                },
                "example": "11111111-1111-4111-8111-111111111111"
              },
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                },
                "example": "private, no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "not_ready"
                    },
                    "service": {
                      "const": "ai_inference"
                    }
                  },
                  "required": [
                    "status",
                    "service"
                  ],
                  "additionalProperties": false
                },
                "example": {
                  "status": "not_ready",
                  "service": "ai_inference"
                }
              }
            }
          }
        },
        "x-status": "implemented",
        "x-owner": "ai_inference",
        "x-increment": 0,
        "x-visibility": "internal"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "UserBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Firma, issuer, audience, expiry, revocación/estado de cuenta. Solo identidad de usuario."
      },
      "ServiceBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Identidad ai_inference; audience interna dedicada. Bearer de usuario no autoriza. Algoritmo/configuración en ADR de seguridad antes de incremento 1/3."
      },
      "RefreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Secure-agro_refresh",
        "description": "Cookie HttpOnly; Secure; SameSite=Lax; Path=/api/v1/auth; sin Domain. Rotación y revocación."
      },
      "CsrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "Debe coincidir con token ligado a sesión; además verificar Origin permitido."
      }
    }
  }
}
