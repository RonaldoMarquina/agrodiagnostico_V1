                  "description": "Fencing UUID sin autoridad de autenticación."
                },
                "crop_code": {
                  "type": "string",
                  "enum": [
                    "POTATO",
                    "MAIZE"
                  ]
                },
                "outcome": {
                  "const": "PREDICTION"
                },
                "model_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "model_version": {
