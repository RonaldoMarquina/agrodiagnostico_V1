                "class_code": {
                  "type": "string",
                  "enum": [
                    "POTATO_HEALTHY",
                    "POTATO_EARLY_BLIGHT",
                    "POTATO_LATE_BLIGHT",
                    "MAIZE_HEALTHY",
                    "MAIZE_COMMON_RUST",
                    "MAIZE_LEAF_BLIGHT",
                    "MAIZE_GRAY_LEAF_SPOT"
                  ]
                },
                "raw_score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
