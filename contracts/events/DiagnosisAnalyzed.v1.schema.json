                "raw_score"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "crop_code": {
                        "const": "POTATO"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "class_code": {
                        "type": "string",
                        "enum": [
                          "POTATO_HEALTHY",
                          "POTATO_EARLY_BLIGHT",
                          "POTATO_LATE_BLIGHT"
                        ]
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "crop_code": {
                        "const": "MAIZE"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "class_code": {
                        "type": "string",
                        "enum": [
                          "MAIZE_HEALTHY",
                          "MAIZE_COMMON_RUST",
                          "MAIZE_LEAF_BLIGHT",
                          "MAIZE_GRAY_LEAF_SPOT"
                        ]
                      }
