{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiagnosisFinished v1",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "properties": {
        "event_type": {
          "const": "DiagnosisFinished"
        },
        "payload": {
          "type": "object",
          "properties": {
            "diagnosis_id": {
              "$ref": "../schemas/common.schema.json#/$defs/UUID"
            },
            "owner_id": {
              "$ref": "../schemas/common.schema.json#/$defs/UUID"
            },
            "final_status": {
              "type": "string",
              "enum": [
                "COMPLETADO",
                "NO_CONCLUYENTE",
                "FALLIDO"
              ]
            }
          },
          "required": [
            "diagnosis_id",
            "owner_id",
            "final_status"
          ],
          "additionalProperties": false
        }
      }
    }
  ]
}
