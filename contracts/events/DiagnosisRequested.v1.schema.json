{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiagnosisRequested v1",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "properties": {
        "event_type": {
          "const": "DiagnosisRequested"
        },
        "payload": {
          "type": "object",
          "properties": {
            "diagnosis_id": {
              "$ref": "../schemas/common.schema.json#/$defs/UUID"
            },
            "owner_id": {
              "$ref": "../schemas/common.schema.json#/$defs/UUID"
            },
            "object_key": {
              "type": "string",
              "pattern": "^diagnoses/[0-9a-fA-F-]{36}/[0-9a-fA-F-]{36}$",
              "description": "Clave privada opaca; sin URL, querystring, credenciales ni nombre del usuario."
            }
          },
          "required": [
            "diagnosis_id",
            "owner_id",
            "object_key"
          ],
          "additionalProperties": false
        }
      }
    }
  ]
}
